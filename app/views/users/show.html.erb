<h1><%= @user.email %></h1>

<section>
  <h2>Events created</h2>
  <% if @events.any? %>
    <%= render partial: "events/event", collection: @events %>
  <% else %>
    <p class="empty">No events yet.</p>
  <% end %>
</section>

<% upcoming = @user.attended_events.visible_to(current_user).upcoming.order("events.date ASC") %>
<% past = @user.attended_events.visible_to(current_user).past.order("events.date DESC") %>

<section>
  <h2>Attending: upcoming</h2>
  <% if upcoming.any? %>
    <%= render partial: "events/event", collection: upcoming %>
  <% else %>
    <p class="empty">No upcoming events.</p>
  <% end %>
</section>

<section>
  <h2>Attending: past</h2>
  <% if past.any? %>
    <%= render partial: "events/event", collection: past %>
  <% else %>
    <p class="empty">No past events.</p>
  <% end %>
</section>
