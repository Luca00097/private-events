<h1><%= @user.email %></h1>

<h2>Events created</h2>

<% if @events.any? %>
  <% @events.each do |event| %>
    <p><%= event.title %> — <%= event.location %></p>
  <% end %>
<% else %>
  <p>No events yet.</p>
<% end %>

<h2>Events attending</h2>

<% if @user.attended_events.any? %>
  <ul>
    <% @user.attended_events.each do |event| %>
      <li><%= link_to event.title, event_path(event) %> — <%= event.location %></li>
    <% end %>
  </ul>
<% else %>
  <p>Not attending any events yet.</p>
<% end %>
