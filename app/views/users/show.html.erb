<h1><%= @user.email %></h1>

<h2>Events created</h2>

<% if @events.any? %>
  <% @events.each do |event| %>
    <p><%= event.title %> — <%= event.location %></p>
  <% end %>
<% else %>
  <p>No events yet.</p>
<% end %>

<% upcoming = @user.attended_events.where("events.date >= ?", Time.current).order("events.date ASC") %>
<% past = @user.attended_events.where("events.date < ?", Time.current).order("events.date DESC") %>

<h2>Upcoming events</h2>
<% if upcoming.any? %>
  <ul>
    <% upcoming.each do |event| %>
      <li><%= link_to event.title, event_path(event) %> — <%= event.date %></li>
    <% end %>
  </ul>
<% else %>
  <p>No upcoming events.</p>
<% end %>

<h2>Past events</h2>
<% if past.any? %>
  <ul>
    <% past.each do |event| %>
      <li><%= link_to event.title, event_path(event) %> — <%= event.date %></li>
    <% end %>
  </ul>
<% else %>
  <p>No past events.</p>
<% end %>
