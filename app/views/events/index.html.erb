<h1>Events</h1>

<section>
  <h2>Upcoming</h2>
  <% if @upcoming_events.any? %>
    <%= render partial: "event", collection: @upcoming_events %>
  <% else %>
    <p class="empty">No upcoming events.</p>
  <% end %>
</section>

<section>
  <h2>Past</h2>
  <% if @past_events.any? %>
    <%= render partial: "event", collection: @past_events %>
  <% else %>
    <p class="empty">No past events.</p>
  <% end %>
</section>
