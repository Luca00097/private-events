<%= form_with model: event do |form| %>
  <% if event.errors.any? %>
    <ul>
      <% event.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :date %>
    <%= form.datetime_field :date %>
  </div>

  <div>
    <%= form.label :location %>
    <%= form.text_field :location %>
  </div>

  <div>
    <%= form.check_box :is_private %>
    <%= form.label :is_private, "Private event (only you and invited people can see it)" %>
  </div>

  <%= form.submit %>
<% end %>
