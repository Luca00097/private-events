<h1><%= @event.title %></h1>
<p><%= @event.description %></p>
<p>When: <%= @event.date %></p>
<p>Where: <%= @event.location %></p>
<p>Hosted by: <%= link_to @event.creator.email, user_path(@event.creator) %></p>
<% if user_signed_in? %>
  <% if @event.attendees.include?(current_user) %>
    <p>You're attending this event.</p>
  <% else %>
    <%= button_to "Attend", event_attendances_path(@event) %>
  <% end %>
<% end %>
